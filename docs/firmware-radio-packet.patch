@@ -10,10 +10,27 @@ extern Rocket_States_t Rocket;
 
 // Builds the telemetry CSV line, returns its length or -1 if it does not fit.
 // Reads live data because the SD snapshot is not updated on the pad.
+//
+// Fields, after the callsign, in the SD row's order with the magnetometer and
+// the two control errors left out (all x100 unless noted):
+//   tick ms (x1), flight state (x1), accel xyz mg, gyro xyz dps,
+//   roll, pitch, yaw, tilt deg, altitude m, velocity m/s, pressure Pa,
+//   temperature degC, pwm angle deg,
+//   gps fix (x1), latitude, longitude deg (x1e7), gps altitude m, speed km/h
+// The ground station decodes by position, so any change here needs the same
+// change in its column list. Longest realistic line is about 180 bytes, which
+// is about 0.9 s on air at SF9 / 125 kHz: do not add fields without checking
+// the air time against RADIO_PERIOD_MS.
 int Radio_BuildPacket(char *buffer, size_t size)
 {
     float accel[3];
     float gyro[3];
+    float rpy[3];
+    float tiltAngle;
+    float position;
+    float velocity;
+    float pressure;
+    float temperature;
     float pwmAngle;
     FlightState_t flightState;
     GpsFix_t gps;
@@ -23,7 +40,13 @@ int Radio_BuildPacket(char *buffer, size_t size)
     {
         accel[i] = Rocket.rawData.accel[i];
         gyro[i] = Rocket.rawData.gyro[i];
+        rpy[i] = Rocket.estimate.rpy[i];
     }
+    tiltAngle = Rocket.estimate.tilt_angle;
+    position = Rocket.estimate.position;
+    velocity = Rocket.estimate.velocity;
+    pressure = Rocket.rawData.pressure;
+    temperature = Rocket.rawData.temperature;
     pwmAngle = Rocket.control.pwmAngle;
     flightState = Rocket.flightState;
     gps = Rocket.gps;
@@ -35,7 +58,7 @@ int Radio_BuildPacket(char *buffer, size_t size)
     }
 
     int len = snprintf(buffer, size,
-                       RFM9X_CALLSIGN ",%lu,%d,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%d,%ld,%ld,%ld,%ld",
+                       RFM9X_CALLSIGN ",%lu,%d,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%ld,%d,%ld,%ld,%ld,%ld",
                        (unsigned long)osKernelGetTickCount(),
                        (int)flightState,
                        (long)(accel[0] * 100),
@@ -44,6 +67,14 @@ int Radio_BuildPacket(char *buffer, size_t size)
                        (long)(gyro[0] * 100),
                        (long)(gyro[1] * 100),
                        (long)(gyro[2] * 100),
+                       (long)(rpy[0] * 100),
+                       (long)(rpy[1] * 100),
+                       (long)(rpy[2] * 100),
+                       (long)(tiltAngle * 100),
+                       (long)(position * 100),
+                       (long)(velocity * 100),
+                       (long)(pressure * 100),
+                       (long)(temperature * 100),
                        (long)(pwmAngle * 100),
                        (int)gps.has_fix,
                        (long)(gps.latitude * 1e7),
